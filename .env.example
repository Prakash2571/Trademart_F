#######################################################################
# Trademart frontend - example environment
#
# Copy to .env.local:   cp .env.example .env.local
#
# ONLY the backend URL belongs here.
#
# Next.js exposes every NEXT_PUBLIC_* variable to the browser, so NEVER add:
#   - Shopify Admin API access token
#   - Shopify client secret / webhook secret
#   - database credentials
#   - Meta / Google Ads tokens
#   - payment or Tradelle credentials
#
# The browser talks only to the Trademart backend, which holds the secrets.
#######################################################################

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
