#######################################################################
# Trademart frontend - example environment
#
# Copy to .env.local:   cp .env.example .env.local
#
# ONLY the backend URL belongs here.
#
# Next.js exposes every NEXT_PUBLIC_* variable to the browser, so NEVER add:
#   - Shopify Admin API access token
#   - Shopify client secret / webhook secret
#   - database credentials
#   - Meta / Google Ads tokens
#   - payment or Tradelle credentials
#
# The browser talks only to the Trademart backend, which holds the secrets.
#
# Operator authentication needs NO frontend variable: the session lives in an
# HttpOnly cookie the backend sets, which this app cannot (and must not) read.
# The API client sends requests with credentials:'include' so the cookie flows.
#
# Cross-origin note: in local dev the frontend (:3000) and backend (:4000) are
# the SAME site (both localhost), so the SameSite=Lax session cookie is sent.
# In production, serve the API under the same origin (e.g. /api behind nginx)
# so cookies work without SameSite=None.
#######################################################################

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
